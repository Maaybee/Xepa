# Copie para api/.env e preencha os valores.

# Servidor
PORT=3333
NODE_ENV=development

# Banco (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xepa
# Conexões simultâneas no pool
DB_POOL_MAX=10

# Sessão — RNF09: expira em 30 minutos de inatividade
SESSION_TTL_MINUTES=30

# Recuperação de senha (RF005) — validade do token de redefinição
RESET_TOKEN_TTL_MINUTES=30

# Importação de notas da instituição (RF023). Vazio = indisponível, que é o
# normal — a maioria das instituições não expõe integração e a entrada manual
# (RF024) é o caminho principal. "stub" devolve notas fixas, só fora de
# produção, para testar o fluxo.
INSTITUICAO_INTEGRACAO=

# Serviço de E-mail. Sem SMTP_HOST, o link de redefinição é apenas logado
# no console (modo de desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=nao-responda@xepa.app

# Base usada para montar o link de redefinição enviado por e-mail
APP_RESET_URL=xepa://redefinir-senha
