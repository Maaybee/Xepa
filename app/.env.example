# Copie para app/.env. Variáveis expostas ao app precisam do prefixo
# EXPO_PUBLIC_ — sem ele o valor não chega ao bundle.
#
#     cp .env.example .env
#
# O endereço muda conforme onde o app roda, porque "localhost" significa
# coisas diferentes em cada um:
#
#   Simulador iOS      http://localhost:3333/api
#   Emulador Android   http://10.0.2.2:3333/api   ← localhost lá é o próprio
#                                                   aparelho; 10.0.2.2 é a
#                                                   máquina que hospeda
#   Aparelho físico    http://192.168.0.10:3333/api
#                      (o IP da sua máquina na rede local; o aparelho precisa
#                       estar no mesmo Wi-Fi)
#
# No emulador Android também dá para usar localhost, desde que você abra o
# túnel do adb antes:
#     adb reverse tcp:3333 tcp:3333
#
# Mudança aqui só vale depois de reiniciar o Metro: o valor é embutido no
# bundle, não lido em tempo de execução.
EXPO_PUBLIC_API_URL=http://localhost:3333/api
