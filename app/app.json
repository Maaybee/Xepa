{
  "expo": {
    "name": "Xepa",
    "slug": "xepa",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "xepa",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.xepa.client"
    },
    "android": {
      "package": "app.xepa.client",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1E8",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
